# =============================================================================
# FLVS - Application Routes (included in server blocks)
# =============================================================================

# Client max body size (for file uploads)
client_max_body_size 50M;

# Static files
location /static/ {
    alias /var/www/static/;
    expires 30d;
    add_header Cache-Control "public, immutable";
    access_log off;
}

# Media files (user uploads)
location /media/ {
    alias /var/www/media/;
    expires 7d;
    add_header Cache-Control "public";
    
    # Security: Prevent script execution in uploads
    location ~* \.(php|py|pl|sh|cgi)$ {
        deny all;
    }
}

# Health check endpoint
location /health/ {
    proxy_pass http://django;
    proxy_set_header Host $client_host;
    access_log off;
}

# Django Admin (rate limited)
location /admin/ {
    limit_req zone=general burst=20 nodelay;
    proxy_pass http://django;
    proxy_set_header Host $client_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $client_proto;
}

# Login endpoint (strict rate limiting)
location /login/ {
    limit_req zone=login burst=5 nodelay;
    proxy_pass http://django;
    proxy_set_header Host $client_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $client_proto;
}

# API endpoints
location /api/ {
    limit_req zone=general burst=50 nodelay;
    proxy_pass http://django;
    proxy_set_header Host $client_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $client_proto;
}

# All other requests to Django
location / {
    limit_req zone=general burst=30 nodelay;
    proxy_pass http://django;
    proxy_set_header Host $client_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $client_proto;
    proxy_redirect off;
    
    # WebSocket support (if needed for HTMX)
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
}

# Favicon
location = /favicon.ico {
    alias /var/www/static/favicon.ico;
    access_log off;
    log_not_found off;
}

# Robots.txt
location = /robots.txt {
    alias /var/www/static/robots.txt;
    access_log off;
    log_not_found off;
}
