# =============================================================================
# FLVS - Environment Configuration
# =============================================================================
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an:
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
# WICHTIG: Generieren Sie einen neuen Secret Key für Production!
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Debug-Modus (NIEMALS True in Production!)
DEBUG=False

# Erlaubte Hosts (kommasepariert)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.de

# Domain für Nginx/SSL
DOMAIN=your-domain.de

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=flvs
POSTGRES_USER=flvs
POSTGRES_PASSWORD=your-secure-database-password

# Alternativ: Vollständige Database URL
# DATABASE_URL=postgres://flvs:password@db:5432/flvs

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.de
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.de
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@your-domain.de

# -----------------------------------------------------------------------------
# Ports (für Docker)
# -----------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Backup Settings (optional)
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Superuser (optional - für automatische Erstellung beim ersten Start)
# -----------------------------------------------------------------------------
# CREATE_SUPERUSER=true
# SUPERUSER_USERNAME=admin
# SUPERUSER_PASSWORD=changeme123
# SUPERUSER_EMAIL=admin@your-domain.de

# -----------------------------------------------------------------------------
# SSL/HTTPS (optional - für Certbot)
# -----------------------------------------------------------------------------
# CERTBOT_EMAIL=admin@your-domain.de

# SSL-Einstellungen (Standard: true)
# Auf false setzen für:
# - Initiale Installation ohne SSL-Zertifikat
# - Deployment hinter SSL-terminierendem Load Balancer
# - Lokale Test-Umgebungen
# USE_SSL=false
